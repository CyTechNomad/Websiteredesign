---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title={`${post.data.title} — CHowell.Dev`} currentPath="/blog">
  <div class="container mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-12 lg:py-16 relative z-10">
    <div class="max-w-4xl mx-auto">
      <!-- Back link -->
      <a 
        href="/blog" 
        class="inline-flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors mb-6 sm:mb-8 font-mono text-sm"
      >
        <!-- ArrowLeft icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        <span>cd ..</span>
      </a>

      <!-- Article header -->
      <header class="mb-8 sm:mb-12">
        <div class="text-xs sm:text-sm text-muted-foreground mb-2 font-mono">
          <span class="text-primary">$</span> cat {post.slug}.md
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl text-foreground mb-4 leading-tight font-semibold">
          {post.data.title}
        </h1>
        
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 text-sm text-muted-foreground">
          <div class="flex items-center gap-2 font-mono">
            <!-- Calendar icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </div>
          
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold border-muted-foreground/30 bg-muted/50 text-muted-foreground">
                <span class="text-muted-foreground/50 mr-1">#</span>
                {tag}
              </span>
            ))}
          </div>
        </div>
      </header>

      <!-- Article content -->
      <article class="prose max-w-none">
        <Content />
      </article>

      <!-- Footer -->
      <footer class="mt-12 sm:mt-16 pt-8 border-t border-muted-foreground/20">
        <a 
          href="/blog" 
          class="inline-flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors font-mono text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          <span>Back to all posts</span>
        </a>
      </footer>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Structural prose styles - colors handled in globals.css */
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    font-weight: 600;
  }

  .prose h1 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .prose h1 {
      font-size: 1.875rem;
    }
  }

  .prose h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid hsl(var(--muted-foreground) / 0.2);
  }

  @media (min-width: 640px) {
    .prose h2 {
      font-size: 1.5rem;
    }
  }

  .prose h3 {
    font-size: 1.125rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .prose h3 {
      font-size: 1.25rem;
    }
  }

  .prose p {
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .prose a {
    transition: all 0.2s;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose code {
    background-color: hsl(var(--muted) / 0.5);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .prose pre {
    background-color: hsl(var(--card) / 0.8);
    border: 1px solid hsl(var(--muted-foreground) / 0.2);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
  }

  .prose ul,
  .prose ol {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .prose ul li::marker,
  .prose ol li::marker {
    color: hsl(var(--muted-foreground));
  }

  .prose ol li::marker {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .prose blockquote {
    border-left: 3px solid hsl(var(--muted-foreground) / 0.3);
    padding-left: 1rem;
    font-style: italic;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose hr {
    border-color: hsl(var(--muted-foreground) / 0.2);
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose .astro-code {
    background-color: hsl(var(--card) / 0.8);
    border: 1px solid hsl(var(--muted-foreground) / 0.2);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
