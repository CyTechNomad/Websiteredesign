---
export interface TimelineItem {
  text: string;
}

interface Props {
  items: TimelineItem[];
  nodeColor: string; // Tailwind bg class for the node (e.g., 'bg-primary')
  lineColor: string; // Tailwind bg class for the line (e.g., 'bg-primary/20')
}

const { items, nodeColor, lineColor } = Astro.props;
---

<div class="relative">
  <!-- Continuous vertical line -->
  <div class={`absolute left-1.75 sm:left-2.25 top-0 bottom-0 w-0.5 ${lineColor}`}></div>

  <!-- Timeline items -->
  <div class="space-y-0">
    {items.map((item) => (
      <div class="relative flex items-start gap-3 sm:gap-4">
        <!-- Node -->
        <div class="relative shrink-0 w-2.5 sm:w-3 pt-3.75 sm:pt-4">
          <div class={`w-2.5 h-2.5 ml-[.20rem] mt-[.20rem] sm:mt-[.5rem] sm:w-3 sm:h-3 rounded-full ${nodeColor} relative z-10`}></div>
        </div>
        <!-- Content -->
        <p class="flex-1 text-muted-foreground text-sm sm:text-base leading-relaxed py-3 sm:py-4">
          <span class="text-primary terminal-prompt"></span>
          {item.text}
        </p>
      </div>
    ))}
  </div>
</div>
