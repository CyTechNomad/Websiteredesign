---
// About Page - Astro component (no client-side JS needed)
---

<div class="container mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-12 lg:py-16 relative z-10">
  <div class="max-w-5xl mx-auto">
    <div class="mb-6 sm:mb-8 lg:mb-12">
      <div class="text-xs sm:text-sm text-muted-foreground mb-2 font-mono">
        <span class="text-primary">$</span> cat about.txt
      </div>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl">
        <span class="text-muted-foreground/50">~/</span><span class="glow-amber">about</span>
      </h1>
    </div>
    
    <!-- Who am I section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 lg:gap-12 mb-8 sm:mb-12 lg:mb-16">
      <div class="flex justify-center items-start">
        <div class="relative group">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/30 via-[#00d4ff]/30 to-accent/30 rounded-full blur-2xl group-hover:blur-3xl transition-all duration-300"></div>
          <div class="relative w-48 h-48 sm:w-56 sm:h-56 lg:w-64 lg:h-64 rounded-full overflow-hidden border-2 border-primary/30 group-hover:border-primary/50 transition-all duration-300 glow-border scanline">
            <img
              src="/photos/chowell.jpeg"
              alt="Christian Howell"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-2 -right-2 px-2 sm:px-3 py-1 bg-card border border-primary/30 rounded text-xs font-mono text-primary">
            [AUTHENTICATED]
          </div>
        </div>
      </div>
      
      <div class="space-y-4 sm:space-y-6">
        <div class="flex items-center gap-1.5 sm:gap-2 mb-3 sm:mb-4">
          <!-- User icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-primary flex-shrink-0"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <h2 class="text-lg sm:text-xl lg:text-2xl glow-text">
            <span class="text-muted-foreground/50">function </span>
            whoAmI()
          </h2>
        </div>
        <div class="space-y-3 sm:space-y-4 text-muted-foreground pl-3 sm:pl-4 border-l-2 border-primary/20 about-content">
          <p class="leading-relaxed text-sm sm:text-base">
            <span class="terminal-prompt"></span>
            Hi, I'm Christian. I'm a God fearing: father, husband, eagle scout, and software engineer. 
            I love learning new things and solving problems. I'm always looking for new opportunities to 
            challenge myself.
          </p>
          <p class="leading-relaxed text-sm sm:text-base">
            <span class="terminal-prompt"></span>
            I'm currently working as a software engineer at{' '}
            <a 
              href="https://firstorion.com" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-primary hover:glow-text transition-all duration-300"
            >
              [First_Orion]
            </a>
            {' '}in my home state of Arkansas. Outside of work, I enjoy spending time with my family and 
            friends, hiking, and playing video games.
          </p>
        </div>
      </div>
    </div>

    <!-- Separator -->
    <div class="my-8 sm:my-12 lg:my-16 h-[1px] w-full bg-primary/20"></div>

    <!-- Passion for backend section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 lg:gap-12 items-center">
      <div class="space-y-4 sm:space-y-6 order-2 md:order-1">
        <div class="flex items-center gap-1.5 sm:gap-2 mb-3 sm:mb-4">
          <!-- Code icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-accent flex-shrink-0"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <h2 class="text-lg sm:text-xl lg:text-2xl glow-orange">
            <span class="text-muted-foreground/50">const </span>
            passion = "backend"
          </h2>
        </div>
        <div class="space-y-3 sm:space-y-4 text-muted-foreground pl-3 sm:pl-4 border-l-2 border-accent/20 about-content">
          <p class="leading-relaxed text-sm sm:text-base">
            <span class="terminal-prompt"></span>
            I love everything about what I do, but I'm most passionate about backend development. 
            I enjoy working with APIs, databases, and serverless technologies.
          </p>
          <p class="leading-relaxed text-sm sm:text-base">
            <span class="terminal-prompt"></span>
            I have experience with a variety of technologies including{' '}
            <span class="text-primary">Go</span>,{' '}
            <span class="text-primary">Node.js</span>,{' '}
            <span class="text-primary">Python</span>, and{' '}
            <span class="text-primary">Java</span>. I'm also experienced 
            with <span class="text-primary">Docker</span>, <span class="text-primary">Kubernetes</span>, and cloud technologies such as <span class="text-primary">AWS</span>.
          </p>
          <p class="leading-relaxed text-sm sm:text-base">
            <span class="terminal-prompt"></span>
            Creating new services and optimizing existing ones is something I find very rewarding.
          </p>
        </div>
      </div>

      <div class="flex justify-center order-1 md:order-2">
        <div class="relative w-56 h-56 sm:w-64 sm:h-64 lg:w-80 lg:h-80 group">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/30 via-primary/30 to-[#ffd700]/30 rounded-3xl blur-2xl group-hover:blur-3xl transition-all duration-300"></div>
          <div class="relative w-full h-full bg-gradient-to-br from-accent/10 to-primary/10 rounded-3xl flex items-center justify-center border-2 border-accent/30 group-hover:border-accent/50 transition-all duration-300 backdrop-blur-sm scanline overflow-hidden">
            <img 
              src="/images/json_gopher.gif" 
              alt="Go Gopher using laptop with JSON on screen"
              class="w-full h-full object-contain p-4"
            />
            <div class="absolute top-3 left-3 sm:top-4 sm:left-4 text-xs text-accent/50 font-mono">
              {'<GOPHER.lang />'}
            </div>
            <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 text-xs text-primary/50 font-mono">
              [RUNTIME: GO]
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Terminal-style footer with stats -->
    <div class="mt-8 sm:mt-12 lg:mt-16 rounded-xl border bg-card/30 border-primary/20 font-mono text-xs sm:text-sm">
      <div class="p-4 sm:p-6 space-y-2">
        <div class="text-muted-foreground">
          <span class="text-primary">$</span> cat /proc/developer/stats
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 mt-3 sm:mt-4">
          <div class="flex items-center gap-2">
            <!-- Heart icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-accent flex-shrink-0"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            <span class="text-muted-foreground">Location:</span>
            <span class="text-primary">Arkansas, USA</span>
          </div>
          <div class="flex items-center gap-2">
            <!-- Code icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary flex-shrink-0"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span class="text-muted-foreground">Status:</span>
            <span class="text-primary">{'{ coding: true }'}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-muted-foreground">Role:</span>
            <span class="text-primary">Software_Engineer</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
