---
import Timeline from './Timeline.astro';
import ScrollAnimations from './ScrollAnimations.astro';
import ScrollIndicator from './ScrollIndicator.astro';
import type { TimelineItem } from './Timeline.astro';
import { getCollection } from "astro:content";

// Calculate years of experience from start date
function getYearsExperience(startDate: Date): number {
  const now = new Date();
  const years = now.getFullYear() - startDate.getFullYear();
  const monthDiff = now.getMonth() - startDate.getMonth();
  // If we haven't reached the anniversary month yet, subtract a year
  if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < startDate.getDate())) {
    return years - 1;
  }
  return years;
}

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

const firstOrionStart = new Date('2022-01-13');
const uaccmStart = new Date('2019-09-01');
const uaccmEnd = new Date('2021-12-31');

const firstOrionYears = getYearsExperience(firstOrionStart);
const uaccmYears = Math.round((uaccmEnd.getTime() - uaccmStart.getTime()) / (1000 * 60 * 60 * 24 * 365));

// Get latest blog posts
const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const skills = [
  "Go",
  "Kotlin",
  "Rust",
  "AWS",
  "Kubernetes",
  "Terraform",
  "Secure System Design",
  "gRPC",
  "Distributed Systems",
  "OpenTelemetry",
];

const experienceItems: TimelineItem[] = [
  { 
    text: "Software Engineer at First Orion (2022–Present)",
    subItems: [
      "Go & Kotlin microservices for high-throughput production systems",
      "Kubernetes on AWS EKS — deployments, upgrades, incident recovery",
      "Terraform modules & infrastructure as code for reusable AWS infrastructure",
      "Production incident investigation across distributed systems",
    ]
  },
  { 
    text: "IT Specialist at UACCM (2019–2021)",
    subItems: [
      "Systems & infrastructure maintenance with focus on availability",
      "Troubleshooting system, network, and permission issues",
      "Vulnerability mitigation and system patching",
    ]
  },
];

const educationItems: TimelineItem[] = [
  { 
    text: "OffSec Certified CyberCore (OSCC-SEC)",
    subItems: [
      "Issued Aug 2025 · Expires Aug 2028",
      "Credential ID 157692177",
    ]
  },
  { 
    text: "Software Development Apprenticeship (2022)",
    subItems: [
      "Hosted by First Orion",
    ]
  },
  { 
    text: "AS in Computer Information Systems & Technology (2019–2021)",
    subItems: [
      "University of Arkansas Community College at Morrilton",
    ]
  },
];

const projects = [
  {
    title: "Crabmail",
    description: "A terminal-based email client written in Rust, powered by Ratatui.",
    logo: "/icons/ferris.svg",
    color: "text-[#ff6600]",
    url: "https://github.com/CyTechNomad/crabmail",
  },
  {
    title: "chowell.dev",
    description: "This very site. A static site built with Astro.",
    logo: "/icons/astro-icon-gradient.svg",
    logoLight: "/icons/astro-icon-gradient-dark.svg",
    color: "text-[#00d4ff]",
    url: "https://github.com/CyTechNomad/chowell.dev",
  },
  {
    title: "RolleR",
    description: "A simple, yet powerful, dice roller in your terminal written in Rust.",
    logo: "/icons/ferris.svg",
    color: "text-[#ff00ff]",
    url: "https://github.com/CyTechNomad/RolleR",
  },
];

const toolCategories = [
  {
    category: "Dev Environment",
    tools: [
      { name: "Neovim", url: "https://neovim.io" },
      { name: "Colima", url: "https://github.com/abiosoft/colima" },
    ],
  },
  {
    category: "Kubernetes/Infra",
    tools: [
      { name: "k9s", url: "https://k9scli.io" },
      { name: "ArgoCD", url: "https://argoproj.github.io/cd" },
      { name: "Atlantis", url: "https://www.runatlantis.io" },
    ],
  },
  {
    category: "CLI Utilities",
    tools: [
      { name: "just", url: "https://github.com/casey/just" },
      { name: "zoxide", url: "https://github.com/ajeetdsouza/zoxide" },
      { name: "tldr", url: "https://tldr.sh" },
    ],
  },
  {
    category: "Networking",
    tools: [
      { name: "Tailscale", url: "https://tailscale.com" },
    ],
  },
];
---

<div class="container mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-12 lg:py-16 relative z-10">
  <!-- Hero Section -->
  <div class="flex flex-col lg:flex-row items-center gap-6 sm:gap-8 lg:gap-12 mb-8 sm:mb-12 lg:mb-20">
    <div class="flex-1 text-center lg:text-left space-y-3 sm:space-y-6 w-full hero-slide-left">
      <div class="inline-block">
        <div class="text-xs sm:text-sm text-muted-foreground mb-2 font-mono">
          <span class="text-primary">$</span> whoami
        </div>
        <h1 class="text-2xl sm:text-4xl lg:text-5xl xl:text-6xl mb-2 sm:mb-4 glow-amber leading-tight">
          Christian C. Howell
        </h1>
        <div class="flex items-center justify-center lg:justify-start gap-1.5 sm:gap-2">
          <span class="text-muted-foreground text-sm sm:text-base">[</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-accent flex-shrink-0"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span class="text-accent glow-orange text-sm sm:text-base lg:text-lg">Software Engineer</span>
          <span class="text-muted-foreground text-sm sm:text-base">]</span>
        </div>
        <p class="text-muted-foreground text-sm sm:text-base mt-3 sm:mt-4 max-w-md mx-auto lg:mx-0">
          <span class="terminal-prompt"></span>
          Building reliable backend systems that scale.
        </p>
      </div>
    </div>

    <div class="flex-shrink-0 hero-fade-in">
      <div class="relative w-40 h-40 sm:w-48 sm:h-48 lg:w-64 lg:h-64 group animate-float">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-[#00d4ff]/20 to-accent/20 rounded-lg blur-xl group-hover:blur-2xl transition-all duration-300 animate-pulse-glow dark-only"></div>
        <div class="relative w-full h-full border-2 border-primary/30 rounded-lg flex items-center justify-center bg-card/50 backdrop-blur-sm group-hover:border-primary/50 transition-all duration-300 scanline overflow-hidden">
          <img
            src="/images/pixel_developer.png"
            alt="Pixel art of a developer working at a computer"
            class="w-full h-full object-contain p-2"
          />
          <div class="absolute top-2 left-2 text-xs text-primary/50 font-mono">[AVATAR.exe]</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 lg:gap-12">
    <!-- Left Column - Skills, Experience, Education -->
    <div class="space-y-6 sm:space-y-8 lg:space-y-10">
      <!-- Skills -->
      <div class="relative animate-flip">
        <div class="flex items-center gap-1.5 sm:gap-2 mb-3 sm:mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-primary flex-shrink-0"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
          <h2 class="text-xl sm:text-2xl">
            <span class="text-muted-foreground/50">~/</span>
            <span class="glow-text">skills</span>
          </h2>
        </div>
        <div class="flex flex-wrap gap-1.5 sm:gap-2 stagger-pop">
          {skills.map((skill, index) => (
            <span
              class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-primary/30 bg-primary/5 text-primary hover:bg-primary/10 hover:border-primary/50 duration-300 hover:glow-border sm:text-sm"
            >
              <span class="text-muted-foreground mr-1">{"{"}</span>
              {skill}
              <span class="text-muted-foreground ml-1">{"}"}</span>
            </span>
          ))}
        </div>
      </div>

      <!-- Experience -->
      <div class="relative animate-glow delay-100">
        <div class="flex items-center gap-1.5 sm:gap-2 mb-3 sm:mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-accent flex-shrink-0"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
          <h2 class="text-xl sm:text-2xl">
            <span class="text-muted-foreground/50">~/</span>
            <span class="glow-orange">experience</span>
          </h2>
        </div>
        <Timeline items={experienceItems} nodeColor="bg-primary" lineColor="bg-primary/20" />
      </div>

      <!-- Education -->
      <div class="relative animate-glow delay-300">
        <div class="flex items-center gap-1.5 sm:gap-2 mb-3 sm:mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-[#ffd700] flex-shrink-0"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <h2 class="text-xl sm:text-2xl">
            <span class="text-muted-foreground/50">~/</span>
            <span class="glow-gold">education</span>
          </h2>
        </div>
        <Timeline items={educationItems} nodeColor="bg-[#ffd700]" lineColor="bg-[#ffd700]/20" />
      </div>
    </div>

    <!-- Right Column - Projects -->
    <div class="animate-slide-right">
      <div class="flex items-center gap-1.5 sm:gap-2 mb-4 sm:mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-primary flex-shrink-0"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <h2 class="text-xl sm:text-2xl">
          <span class="text-muted-foreground/50">~/</span>
          <span class="glow-text">projects</span>
        </h2>
      </div>
      <div class="space-y-3 sm:space-y-4 stagger-children">
        {projects.map((project) => (
          <div class="group relative rounded-xl border bg-card/50 backdrop-blur-sm border-primary/20 hover:border-primary/50 transition-all duration-300 hover:glow-border overflow-hidden">
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="block cursor-pointer">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="relative p-4 sm:p-6">
                <div class="flex items-start gap-2 sm:gap-3">
                  <div class="w-10 h-10 sm:w-12 sm:h-12 lg:w-14 lg:h-14 flex-shrink-0 flex items-center justify-center">
                    {project.logoLight ? (
                      <>
                        <img src={project.logo} alt={`${project.title} logo`} class="w-full h-full object-contain dark-only" />
                        <img src={project.logoLight} alt={`${project.title} logo`} class="w-full h-full object-contain light-only" />
                      </>
                    ) : (
                      <img src={project.logo} alt={`${project.title} logo`} class="w-full h-full object-contain" />
                    )}
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="font-semibold leading-none tracking-tight flex items-center gap-1.5 sm:gap-2 group-hover:glow-text transition-all duration-300 text-base sm:text-lg">
                      <span class="text-muted-foreground/50 text-xs sm:text-sm">{"["}</span>
                      <span class="truncate">{project.title}</span>
                      <span class="text-muted-foreground/50 text-xs sm:text-sm">{"]"}</span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 sm:w-4 sm:h-4 opacity-0 group-hover:opacity-100 transition-opacity text-primary flex-shrink-0"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    </h3>
                    <p class="text-sm text-muted-foreground mt-1.5 sm:mt-2 leading-relaxed">
                      <span class="terminal-prompt"></span>
                      {project.description}
                    </p>
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

      <!-- Tools I Use Daily -->
      <div class="mt-6 sm:mt-8 animate-on-scroll">
        <div class="flex items-center gap-1.5 sm:gap-2 mb-4 sm:mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-accent flex-shrink-0"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <h2 class="text-xl sm:text-2xl">
            <span class="text-muted-foreground/50">~/</span>
            <span class="glow-orange">daily_tools</span>
          </h2>
        </div>
        <div class="space-y-4">
          {toolCategories.map((category) => (
            <div>
              <div class="text-xs text-muted-foreground/60 font-mono mb-2">
                <span class="text-accent/60">#</span> {category.category}
              </div>
              <div class="flex flex-wrap gap-2 stagger-pop">
                {category.tools.map((tool) => (
                  <a 
                    href={tool.url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-sm font-medium transition-all duration-300 border-accent/30 bg-accent/5 text-accent hover:bg-accent/10 hover:border-accent/50 hover:glow-border cursor-pointer"
                  >
                    <span>{tool.name}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 opacity-50"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Latest Blog Posts Section -->
  <div class="mt-12 sm:mt-16 lg:mt-20 hero-fade-in" style="animation-delay: 0.5s;">
    <div class="flex items-center justify-between mb-4 sm:mb-6">
      <div class="flex items-center gap-1.5 sm:gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-primary flex-shrink-0"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
        <h2 class="text-xl sm:text-2xl">
          <span class="text-muted-foreground/50">~/</span>
          <span class="glow-text">latest_posts</span>
        </h2>
      </div>
      <a href="/blog" class="text-sm text-muted-foreground hover:text-primary transition-colors duration-300 font-mono flex items-center gap-1">
        <span>view all</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 sm:w-4 sm:h-4"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 stagger-children">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group relative rounded-xl border bg-card/50 backdrop-blur-sm border-primary/20 hover:border-primary/50 transition-all duration-300 hover:glow-border cursor-pointer overflow-hidden flex flex-col">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative p-4 sm:p-5 flex-1 flex flex-col">
            <div class="flex items-center gap-1.5 mb-2 text-xs text-muted-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 flex-shrink-0"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
              <span class="font-mono">{formatDate(post.data.date)}</span>
            </div>
            <h3 class="font-semibold text-base sm:text-lg mb-2 text-foreground group-hover:text-foreground/90 transition-all duration-300 leading-tight">
              <span class="text-muted-foreground/50"># </span>
              {post.data.title}
            </h3>
            <p class="text-sm text-muted-foreground/80 leading-relaxed flex-1 line-clamp-2">
              {post.data.description}
            </p>
            <div class="flex flex-wrap gap-1.5 mt-3">
              {post.data.tags.slice(0, 2).map((tag) => (
                <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium border-primary/30 bg-primary/5 text-primary">
                  <span class="text-muted-foreground mr-0.5">#</span>
                  {tag}
                </span>
              ))}
              {post.data.tags.length > 2 && (
                <span class="text-xs text-muted-foreground">+{post.data.tags.length - 2}</span>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</div>

<ScrollAnimations />
<ScrollIndicator />
