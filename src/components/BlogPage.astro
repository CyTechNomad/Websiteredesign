---
// Blog Page - Astro component fetching from content collection
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}
---

<div class="container mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-12 lg:py-16 relative z-10">
  <div class="max-w-4xl">
    <div class="mb-6 sm:mb-8 lg:mb-12">
      <div class="text-xs sm:text-sm text-muted-foreground mb-2 font-mono">
        <span class="text-primary">$</span> cat blog/
      </div>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl">
        <span class="text-muted-foreground/50">~/</span><span class="glow-amber">blog</span>
      </h1>
      <p class="text-muted-foreground mt-3 sm:mt-4 text-sm sm:text-base">
        <span class="terminal-prompt"></span>
        Thoughts, tutorials, and insights on software development
      </p>
    </div>
    
    <div class="space-y-4 sm:space-y-6">
      {posts.map((post, index) => (
        <a href={`/blog/${post.slug}`} class="block group relative rounded-xl border bg-card/50 backdrop-blur-sm border-primary/20 hover:border-primary/50 transition-all duration-300 hover:glow-border cursor-pointer overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative p-4 sm:p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 sm:gap-2 mb-2 sm:mb-3 text-xs sm:text-sm text-muted-foreground">
                  <!-- FileText icon -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                  <span class="font-mono">{post.slug}.md</span>
                </div>
                <h2 class="font-semibold leading-none tracking-tight text-base sm:text-lg lg:text-xl mb-2 text-foreground group-hover:text-foreground/90 transition-all duration-300">
                  <span class="text-muted-foreground/50"># </span>
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="text-sm sm:text-base text-muted-foreground/80 leading-relaxed">
                    {post.data.description}
                  </p>
                )}
              </div>
            </div>
          </div>
          <div class="relative p-4 sm:p-6 pt-0">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div class="flex flex-wrap gap-1.5 sm:gap-2">
                {post.data.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-primary/30 bg-primary/5 text-primary hover:bg-primary/10 hover:border-primary/50 duration-300">
                    <span class="text-muted-foreground mr-1">#</span>
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-muted-foreground">
                <!-- Calendar icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <span class="font-mono">{formatDate(post.data.date)}</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Terminal-style footer -->
    <div class="mt-8 sm:mt-12 rounded-xl border bg-card/30 border-primary/20 font-mono text-xs sm:text-sm">
      <div class="p-3 sm:p-4">
        <div class="text-muted-foreground">
          <span class="text-primary">$</span> echo "More posts coming soon..."
        </div>
        <div class="text-primary mt-1 animate-pulse">_</div>
      </div>
    </div>
  </div>
</div>
